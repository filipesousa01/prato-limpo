# Banco de dados (SQLite no desenvolvimento; troque por uma URL postgresql:// em produção)
DATABASE_URL="file:./dev.db"

# Roboflow — a chave fica SÓ no servidor. Nunca exponha com NEXT_PUBLIC_.
ROBOFLOW_API_KEY=""
ROBOFLOW_MODEL_ID="desperdicio_ru-fwub5"
ROBOFLOW_MODEL_VERSION="35"
ROBOFLOW_CONFIDENCE="0.4"
# Opcional: endpoint base (padrão https://serverless.roboflow.com)
ROBOFLOW_API_URL="https://serverless.roboflow.com"

# Token exigido no header "Authorization: Bearer <token>" (ou "x-ingest-token")
# pelo app que tira as fotos ao chamar POST /api/analises.
INGEST_TOKEN=""
